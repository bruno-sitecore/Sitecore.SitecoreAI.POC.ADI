{
  "$schema": "../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "Project.IndustryVerticles",
  "items": {
    "includes": [
      {
        "name": "module",
        "path": "/sitecore/system/settings/Project/industry-verticals",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "templatesProject",
        "path": "/sitecore/templates/Project/industry-verticals",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "branchesProject",
        "path": "/sitecore/templates/Branches/Project/industry-verticals",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "projectMediaFolders",
        "path": "/sitecore/Media Library/Project/industry-verticals",
        "rules": [
          {
            "path": "/shared",
            "scope": "SingleItem",
            "allowedPushOperations": "CreateOnly"
          },
          {
            "path": "/nova-medical",
            "scope": "SingleItem",
            "allowedPushOperations": "CreateOnly"
          },
          {
            "path": "/essential-living",
            "scope": "SingleItem",
            "allowedPushOperations": "CreateOnly"
          },
          {
            "path": "/forma-lux",
            "scope": "SingleItem",
            "allowedPushOperations": "CreateOnly"
          }
        ]
      },
      {
        "name": "projectRenderings",
        "path": "/sitecore/Layout/Renderings/Project/industry-verticals",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "projectPlaceholderSettings",
        "path": "/sitecore/Layout/Placeholder Settings/Project/industry-verticals",
        "allowedPushOperations": "CreateUpdateAndDelete"
      }
    ]
  }
}
